# App
APP_BASE_URL=http://localhost:3000
DEMO_MODE=false
ALLOWED_EMAILS=

# Database / Prisma
DATABASE_URL=
DIRECT_URL=

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Supabase aliases used by Vercel Marketplace and local tooling
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Canvas
CANVAS_BASE_URL=https://rmit.instructure.com
CANVAS_ALLOWED_HOSTS=*.instructure.com
# Local development only. Prefer user-connected tokens in the app.
CANVAS_ACCESS_TOKEN=

# Encryption
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Support desk email
RESEND_API_KEY=
SUPPORT_FROM_EMAIL=RMIT Study Sidekick <support@example.com>
SUPPORT_TO_EMAIL=support@example.com

# Vercel Cron
CRON_SECRET=
